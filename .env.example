# Copy this file to .env and adjust as needed: `cp .env.example .env`.
#
# This is the only environment variable the app currently reads (see src/lib/prisma.ts).
# There is no OCPP/CSMS config here on purpose: each device instance's CSMS WebSocket URL
# (e.g. ws://<csms-host>/ocpp/<chargePointId>) is set per-instance at runtime, from the
# instance creation form or its Networks tab — not from environment variables. This lets
# one running app point different instances at different CSMS dev/staging environments.

# Postgres connection string used by Prisma (prisma/schema.prisma's `datasource db`).
# The default below matches docker-compose.yml's `postgres` service (`docker compose up -d`),
# which publishes Postgres on the host at localhost:5442.
DATABASE_URL="postgresql://ev_charger_emulator:ev_charger_emulator@localhost:5442/ev_charger_emulator"

# --- Only used by `docker compose --profile full up` (running the app itself in Docker) ---
# Not needed for the primary `npm run dev` flow above; the app and migrate services in
# docker-compose.yml already set DATABASE_URL themselves (pointed at the `postgres` service
# over the compose network), and default PORT/HOSTNAME in the app image's Dockerfile.
# Listed here only for reference if you customize docker-compose.yml.
# PORT=3000
# HOSTNAME=0.0.0.0
