// Domain models: device models (reusable charger-family templates), their connector
// topology, and their typed configuration-parameter schema (added in issue #5), plus
// device *instances* — a model picked, given an identity + CSMS URL, and its own copy
// of the model's parameter values (added in issue #3).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// OCPP protocol version a device model speaks.
enum OcppProtocolVersion {
  OCPP_1_6
  OCPP_2_0_1
}

/// Physical connector type, roughly following common OCPP connectorType values.
enum ConnectorType {
  CCS1
  CCS2
  CHADEMO
  TYPE_1
  TYPE_2
  GBT_AC
  GBT_DC
  TESLA
  OTHER
}

/// Whether a connector delivers AC or DC power.
enum PowerType {
  AC
  DC
}

/// Which settings tab a parameter definition is shown under on the real device,
/// mirrored from the PEVC3107E Setting screen tabs (Device/System/Networks/Fee Rate/Other).
enum ParameterCategory {
  DEVICE
  SYSTEM
  NETWORKS
  FEE_RATE
  OTHER
}

/// The primitive type a parameter's value should be parsed/validated as.
enum ParameterValueType {
  STRING
  INTEGER
  FLOAT
  BOOLEAN
  ENUM
}

/// Live OCPP connection status of a device instance, driven by its OcppClient lifecycle.
enum DeviceConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  FAULTED
}

/// A reusable charger-family template (e.g. "PEVC3107E") that device instances are
/// created from. Holds identity, connector topology, and the typed parameter schema
/// describing every configurable field shown across the device's settings tabs.
model DeviceModel {
  id           String   @id @default(cuid())
  manufacturer String
  brand        String?
  model        String
  ocppProtocol OcppProtocolVersion
  description  String?

  connectors  DeviceModelConnector[]
  parameters  DeviceModelParameter[]
  instances   DeviceInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([manufacturer, model])
}

/// One physical connector (EVSE + connector index) on a device model, e.g. "Plug A".
model DeviceModelConnector {
  id            String @id @default(cuid())
  deviceModelId String
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)

  /// 1-based EVSE index, matching the OCPP evseId/connector numbering the device boots with.
  evseIndex Int
  /// 1-based connector index within the EVSE (almost always 1 for single-connector EVSEs).
  connectorIndex Int
  /// Human label as shown on the device, e.g. "Plug A".
  label String?

  connectorType ConnectorType
  powerType     PowerType
  maxAmperage   Float?
  maxVoltage    Float?
  maxPowerKw    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceModelId, evseIndex, connectorIndex])
  @@index([deviceModelId])
}

/// A single typed configuration field belonging to a device model's parameter schema
/// (one row per settings-screen field), letting new models define their own settings
/// surface without new tables. `defaultValue` is stored as text and interpreted per
/// `valueType`; `enumOptions` is populated only when `valueType` is ENUM.
model DeviceModelParameter {
  id            String @id @default(cuid())
  deviceModelId String
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)

  /// Machine key, e.g. "powerSupplyQuantity".
  key   String
  /// Human label as shown on the device, e.g. "Power supply quantity".
  label String

  category  ParameterCategory
  valueType ParameterValueType

  /// Unit of measure, e.g. "kW", "V", "A", "%", "s", "degC".
  unit String?

  defaultValue String?
  enumOptions  String[]
  minValue     Float?
  maxValue     Float?

  description String?
  sortOrder   Int    @default(0)

  instanceValues DeviceInstanceParameter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceModelId, key])
  @@index([deviceModelId])
}

/// An emulated device created from a DeviceModel: a chosen model plus its own identity
/// (charge point id), CSMS OCPP WebSocket URL, live connection status, and its own copy
/// of the model's parameter values (seeded from the model's defaults, then editable).
model DeviceInstance {
  id            String @id @default(cuid())
  deviceModelId String
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)

  /// Human label for this instance, e.g. "Bay 3 charger".
  name String

  /// OCPP charge point identity (also the last path segment of the CSMS URL for most CSMS's).
  chargePointId String @unique

  /// CSMS OCPP WebSocket URL to connect to, e.g. ws://localhost:9000/CP1.
  csmsUrl String

  status DeviceConnectionStatus @default(DISCONNECTED)
  /// Human-readable detail for the current status, e.g. an error message when FAULTED.
  statusReason    String?
  lastConnectedAt DateTime?

  parameters DeviceInstanceParameter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceModelId])
}

/// One parameter value belonging to a device instance — a per-instance, editable copy of
/// a DeviceModelParameter, seeded from that parameter's defaultValue at creation time.
model DeviceInstanceParameter {
  id String @id @default(cuid())

  deviceInstanceId String
  deviceInstance   DeviceInstance @relation(fields: [deviceInstanceId], references: [id], onDelete: Cascade)

  deviceModelParameterId String
  deviceModelParameter   DeviceModelParameter @relation(fields: [deviceModelParameterId], references: [id], onDelete: Cascade)

  /// Denormalized copy of the model parameter's key, for convenient lookups without a join.
  key   String
  /// Current value, stored as text and interpreted per the model parameter's valueType.
  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceInstanceId, deviceModelParameterId])
  @@index([deviceInstanceId])
}
