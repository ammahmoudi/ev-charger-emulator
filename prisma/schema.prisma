// Domain models: device models (reusable charger-family templates), their connector
// topology, and their typed configuration-parameter schema (added in issue #5), plus
// device *instances* — a model picked, given an identity + CSMS URL, and its own copy
// of the model's parameter values (added in issue #3).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// OCPP protocol version a device model speaks.
enum OcppProtocolVersion {
  OCPP_1_6
  OCPP_2_0_1
}

/// Physical connector type, roughly following common OCPP connectorType values.
enum ConnectorType {
  CCS1
  CCS2
  CHADEMO
  TYPE_1
  TYPE_2
  GBT_AC
  GBT_DC
  TESLA
  OTHER
}

/// Whether a connector delivers AC or DC power.
enum PowerType {
  AC
  DC
}

/// Which settings tab a parameter definition is shown under on the real device,
/// mirrored from the PEVC3107E Setting screen tabs (Device/System/Networks/Fee Rate/Other).
enum ParameterCategory {
  DEVICE
  SYSTEM
  NETWORKS
  FEE_RATE
  OTHER
}

/// The primitive type a parameter's value should be parsed/validated as.
enum ParameterValueType {
  STRING
  INTEGER
  FLOAT
  BOOLEAN
  ENUM
}

/// Live OCPP connection status of a device instance, driven by its OcppClient lifecycle.
enum DeviceConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  FAULTED
}

/// Authorization outcome an idTag carries in the local authorization list/cache, mirroring
/// OCPP 1.6's `AuthorizationStatus` values a charger can decide locally without contacting the CSMS.
enum LocalAuthEntryStatus {
  ACCEPTED
  BLOCKED
  EXPIRED
}

/// OCPP action queued in a device instance's offline outbox (see `DeviceInstanceOutboxMessage`).
/// Values are the literal OCPP 1.6 action names (PascalCase, not SCREAMING_CASE like this file's
/// other enums) because `outbox.ts::drainOutbox` passes `message.action` straight through as the
/// `callOcpp(deviceInstanceId, action, payload)` action string — there's no separate mapping step.
enum OutboxAction {
  StartTransaction
  StopTransaction
  MeterValues
}

/// A reusable charger-family template (e.g. "PEVC3107E") that device instances are
/// created from. Holds identity, connector topology, and the typed parameter schema
/// describing every configurable field shown across the device's settings tabs.
model DeviceModel {
  id           String   @id @default(cuid())
  manufacturer String
  brand        String?
  model        String
  ocppProtocol OcppProtocolVersion
  description  String?

  connectors  DeviceModelConnector[]
  parameters  DeviceModelParameter[]
  instances   DeviceInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([manufacturer, model])
}

/// One physical connector (EVSE + connector index) on a device model, e.g. "Plug A".
model DeviceModelConnector {
  id            String @id @default(cuid())
  deviceModelId String
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)

  /// 1-based EVSE index, matching the OCPP evseId/connector numbering the device boots with.
  evseIndex Int
  /// 1-based connector index within the EVSE (almost always 1 for single-connector EVSEs).
  connectorIndex Int
  /// Human label as shown on the device, e.g. "Plug A".
  label String?

  connectorType ConnectorType
  powerType     PowerType
  maxAmperage   Float?
  maxVoltage    Float?
  maxPowerKw    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceModelId, evseIndex, connectorIndex])
  @@index([deviceModelId])
}

/// A single typed configuration field belonging to a device model's parameter schema
/// (one row per settings-screen field), letting new models define their own settings
/// surface without new tables. `defaultValue` is stored as text and interpreted per
/// `valueType`; `enumOptions` is populated only when `valueType` is ENUM.
model DeviceModelParameter {
  id            String @id @default(cuid())
  deviceModelId String
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)

  /// Machine key, e.g. "powerSupplyQuantity".
  key   String
  /// Human label as shown on the device, e.g. "Power supply quantity".
  label String

  category  ParameterCategory
  valueType ParameterValueType

  /// Unit of measure, e.g. "kW", "V", "A", "%", "s", "degC".
  unit String?

  defaultValue String?
  enumOptions  String[]
  minValue     Float?
  maxValue     Float?

  description String?
  sortOrder   Int    @default(0)

  instanceValues DeviceInstanceParameter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceModelId, key])
  @@index([deviceModelId])
}

/// An emulated device created from a DeviceModel: a chosen model plus its own identity
/// (charge point id), CSMS OCPP WebSocket URL, live connection status, and its own copy
/// of the model's parameter values (seeded from the model's defaults, then editable).
model DeviceInstance {
  id            String @id @default(cuid())
  deviceModelId String
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)

  /// Human label for this instance, e.g. "Bay 3 charger".
  name String

  /// OCPP charge point identity (also the last path segment of the CSMS URL for most CSMS's).
  chargePointId String @unique

  /// CSMS OCPP WebSocket URL to connect to, e.g. ws://localhost:9000/CP1.
  csmsUrl String

  /// A card idTag that always authorizes locally (mirrors a real charger's factory "master card"),
  /// regardless of CSMS connection state — auto-generated at creation, editable from Settings.
  /// Any other idTag presented via the RFID-simulation flow requires a live CSMS connection and
  /// goes through a real Authorize/StartTransaction instead (see `src/lib/device-instances/rfid.ts`).
  masterCardIdTag String?

  status DeviceConnectionStatus @default(DISCONNECTED)
  /// Human-readable detail for the current status, e.g. an error message when FAULTED.
  statusReason    String?
  lastConnectedAt DateTime?

  /// Set while a simulated firmware upgrade (`maintenance.ts::startFirmwareUpgrade`) is in
  /// flight, cleared on completion. Persisted (rather than only the in-memory completion
  /// timer) so a process restart mid-upgrade can detect and finish the stale upgrade instead
  /// of leaving connectors stuck `Unavailable` forever — see `maintenance.ts::resolveStaleFirmwareUpgrade`.
  firmwareUpgradeStartedAt DateTime?

  parameters       DeviceInstanceParameter[]
  events           DeviceInstanceEvent[]
  sessions         DeviceInstanceSession[]
  connectorStates  DeviceInstanceConnectorState[]
  localAuthEntries DeviceInstanceLocalAuthEntry[]
  outboxMessages   DeviceInstanceOutboxMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceModelId])
}

/// One entry in a device instance's local authorization list/cache (mirrors a real charger's
/// `SendLocalList`-populated table plus its authorization cache), letting `rfid.ts::presentRfidCard`
/// authorize a known idTag locally — offline or online — without a live CSMS round-trip, the same
/// way the single `masterCardIdTag` already does. `cacheExpiryDateTime` models the CSMS-assigned
/// expiry an `Authorize`/`StartTransaction` response's `idTagInfo` carries; a null value never expires
/// (matches a `SendLocalList`-seeded entry, as opposed to a cached `Authorize` response).
model DeviceInstanceLocalAuthEntry {
  id String @id @default(cuid())

  deviceInstanceId String
  deviceInstance   DeviceInstance @relation(fields: [deviceInstanceId], references: [id], onDelete: Cascade)

  idTag  String
  status LocalAuthEntryStatus @default(ACCEPTED)

  cacheExpiryDateTime DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceInstanceId, idTag])
  @@index([deviceInstanceId])
}

/// A queued OCPP call that should have reached the CSMS but couldn't (offline, or the call
/// failed) — a real charger's "local storage" transaction queue. Drained in order on reconnect
/// (see `runtime.ts`'s `bootAccepted` handler / `outbox.ts::drainOutbox`), so a StopTransaction
/// generated while disconnected isn't silently dropped, matching a real charger replaying queued
/// Start/Stop/MeterValues messages once its CSMS link comes back.
model DeviceInstanceOutboxMessage {
  id String @id @default(cuid())

  deviceInstanceId String
  deviceInstance   DeviceInstance @relation(fields: [deviceInstanceId], references: [id], onDelete: Cascade)

  action  OutboxAction
  /// The OCPP call payload, exactly as it would be sent via `callOcpp(deviceInstanceId, action, payload)`.
  payload Json

  attempts  Int      @default(0)
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceInstanceId, createdAt])
}

/// One parameter value belonging to a device instance — a per-instance, editable copy of
/// a DeviceModelParameter, seeded from that parameter's defaultValue at creation time.
model DeviceInstanceParameter {
  id String @id @default(cuid())

  deviceInstanceId String
  deviceInstance   DeviceInstance @relation(fields: [deviceInstanceId], references: [id], onDelete: Cascade)

  deviceModelParameterId String
  deviceModelParameter   DeviceModelParameter @relation(fields: [deviceModelParameterId], references: [id], onDelete: Cascade)

  /// Denormalized copy of the model parameter's key, for convenient lookups without a join.
  key   String
  /// Current value, stored as text and interpreted per the model parameter's valueType.
  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceInstanceId, deviceModelParameterId])
  @@index([deviceInstanceId])
}

/// Category of a DeviceInstanceEvent, driving how it's summarized in the Event log (issue #14).
/// Mirrors the lifecycle moments the real device's Event screen surfaces (boot/off-line,
/// status transitions, transactions, faults) plus locally-triggered command handling.
enum DeviceInstanceEventType {
  CONNECTED
  DISCONNECTED
  BOOT
  STATUS_CHANGE
  TRANSACTION_STARTED
  TRANSACTION_STOPPED
  FAULT
  REMOTE_COMMAND
  /// A bottom-nav Maintenance tab admin action (issue #15): event/consumption record clear,
  /// factory parameter restore, or a board firmware upgrade.
  MAINTENANCE
}

/// One row in a device instance's Event log (bottom-nav "Event" screen on the real device):
/// S.N (row position, derived from occurredAt ordering) + occurrence time + free-text
/// description, e.g. "Dev off-line", "Event Clear", "KM opt Err".
model DeviceInstanceEvent {
  id String @id @default(cuid())

  deviceInstanceId String
  deviceInstance   DeviceInstance @relation(fields: [deviceInstanceId], references: [id], onDelete: Cascade)

  type        DeviceInstanceEventType
  description String

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([deviceInstanceId, occurredAt])
}

/// A completed simulated charging session (issue #9), persisted for the Cost/session-history
/// screen and the post-charge summary popup. `stopCause` is free text rather than a strict
/// enum — the real device surfaces its own internal fault codes here ("QF Err", "KM Err") next
/// to normal OCPP-ish stop reasons ("Manu. Stop"), so a closed enum would fight that.
model DeviceInstanceSession {
  id String @id @default(cuid())

  deviceInstanceId String
  deviceInstance   DeviceInstance @relation(fields: [deviceInstanceId], references: [id], onDelete: Cascade)

  /// OCPP connectorId the session ran on ("Gun ID" on the real device).
  connectorId    Int
  /// Denormalized connector label at the time of the session (e.g. "Plug A"), for display
  /// even if the device model's connector topology changes later.
  connectorLabel String?

  /// idTag used to authorize the session ("User Card NO." on the real device).
  idTag         String
  transactionId Int?

  startedAt DateTime
  stoppedAt DateTime

  /// Total energy delivered, in Wh (displayed as kWh).
  energyWh Float
  /// Total cost for the session, in `currency`.
  cost     Float
  currency String?

  /// Free-text stop cause/reason, e.g. "Manu. Stop", "EV Disconnected", "UnlockConnector",
  /// or a device fault code such as "QF Err" / "KM Err" / "Ins Err".
  stopCause String

  createdAt DateTime @default(now())

  @@index([deviceInstanceId, startedAt])
}

/// Live per-connector runtime state for a device instance: current status, manual lock state
/// (issue #14's Lock screen), and the in-progress simulated session (if any). Persisted (rather
/// than kept purely in-memory like `OcppChargePointSession`'s connector map) so the Lock/Cost
/// screens survive a server restart; the active session's energy is derived on read from
/// `activeChargeRateKw` and elapsed wall-clock time rather than a running timer.
model DeviceInstanceConnectorState {
  id String @id @default(cuid())

  deviceInstanceId String
  deviceInstance   DeviceInstance @relation(fields: [deviceInstanceId], references: [id], onDelete: Cascade)

  connectorId Int

  /// Mirrors `OcppChargePointStatus` loosely; kept as a string so this table doesn't need a
  /// migration every time the OCPP status enum grows.
  status String @default("Available")
  /// Manual per-connector lock, toggled from the Lock screen; mirrors `UnlockConnector` but
  /// locally triggerable (issue #14), independent of the CSMS-initiated path from issue #10.
  locked Boolean @default(false)

  activeIdTag        String?
  activeTransactionId Int?
  activeStartedAt     DateTime?
  activeChargeRateKw  Float?
  /// Set when a stopped session enters the `Finishing` hold (mirrors real `PEVC3107E`
  /// `StatusNotification` traffic: `Charging`/`Preparing` -> `Finishing` -> `Available`/`Faulted`)
  /// instead of jumping straight to the final status. Cleared once `resolveFinishingPromotion`
  /// (`connector-sessions.ts`) promotes the connector past the hold.
  finishingSince      DateTime?
  /// The status `finishingSince` will resolve to once its hold elapses ("Available" or "Faulted").
  finishingNextStatus String?
  /// True when the active session was started via a real Authorize/StartTransaction to the CSMS
  /// (the RFID-simulation flow's non-master-card path — see `src/lib/device-instances/rfid.ts`),
  /// as opposed to the purely-local simulation. Tells `stopChargingSession` whether it also needs
  /// to send a real `StopTransaction` so the CSMS's transaction record doesn't dangle open.
  activeIsRemote Boolean @default(false)

  /// Monotonic per-connector counter used to mint `activeTransactionId` values locally.
  transactionCounter Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([deviceInstanceId, connectorId])
}
